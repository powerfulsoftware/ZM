    { "id": "eh-6",  "sira": 6,  "hedef": 99, "translations": { "tr": { "isim": "Es-Selam", "anlami": "Esenlik veren, barış kaynağı" }, "en": { "isim": "As-Salam", "anlami": "The Source of Peace" }, "ar": { "isim": "السلام", "anlami": "الذي يهب السلامة والعافية" }, "az": { "isim": "Əs-Səlam", "anlami": "Sülh verən, əmin-amanlıq mənbəyi" }, "ru": { "isim": "Ас-Салям", "anlami": "Источник мира и безопасности" }, "es": { "isim": "As-Salam", "anlami": "La Fuente de Paz" } } },
