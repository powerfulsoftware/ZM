{
  "esmaulHusna": [
    { "id": "eh-1",  "sira": 1,  "hedef": 99, "translations": { "tr": { "isim": "Allah", "anlami": "İlahiyet sahibi, gerçek ilah" }, "en": { "isim": "Allah", "anlami": "The God, the true deity" }, "ar": { "isim": "الله", "anlami": "الألوهية ومعبود كل شيء" }, "az": { "isim": "Allah", "anlami": "İlahiyət sahibi, həqiqi tanrı" }, "ru": { "isim": "Аллах", "anlami": "Божество, истинный Бог" }, "es": { "isim": "Allah", "anlami": "La divinidad, el dios verdadero" } } },
    { "id": "eh-2",  "sira": 2,  "hedef": 99, "translations": { "tr": { "isim": "Er-Rahman", "anlami": "Dünyadaki tüm canlılara merhamet eden" }, "en": { "isim": "Ar-Rahman", "anlami": "The Most Compassionate" }, "ar": { "isim": "الرحمن", "anlami": "ذو الرحمة الواسعة لجميع الخلق" }, "az": { "isim": "Ər-Rahman", "anlami": "Bütün canlılara rəhm edən" }, "ru": { "isim": "Ар-Рахман", "anlami": "Милостивый ко всем созданиям" }, "es": { "isim": "Ar-Rahman", "anlami": "El Más Compasivo" } } },
    { "id": "eh-3",  "sira": 3,  "hedef": 99, "translations": { "tr": { "isim": "Er-Rahim", "anlami": "Ahirette müminlere merhamet eden" }, "en": { "isim": "Ar-Rahim", "anlami": "The Most Merciful" }, "ar": { "isim": "الرحيم", "anlami": "ذو الرحمة الخاصة بعباده المؤمنين يوم القيامة" }, "az": { "isim": "Ər-Rahim", "anlami": "Axirətdə möminlərə rəhm edən" }, "ru": { "isim": "Ар-Рахим", "anlami": "Милосердный к верующим в загробной жизни" }, "es": { "isim": "Ar-Rahim", "anlami": "El Más Misericordioso" } } },
    { "id": "eh-4",  "sira": 4,  "hedef": 99, "translations": { "tr": { "isim": "El-Melik", "anlami": "Mülkün gerçek sahibi, hükümdar" }, "en": { "isim": "Al-Malik", "anlami": "The King, the Sovereign" }, "ar": { "isim": "الملك", "anlami": "المالك لجميع الأمور والمتصرف فيها" }, "az": { "isim": "Əl-Məlik", "anlami": "Mülkün həqiqi sahibi, hökmdar" }, "ru": { "isim": "Аль-Малик", "anlami": "Властелин, Царь" }, "es": { "isim": "Al-Malik", "anlami": "El Rey, el Soberano" } } },
